<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_inventory_material_request" model="ir.sequence">
            <field name="name">Material Request</field>
            <field name="code">inventory.material.request</field>
            <field name="prefix">MR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_engineering_stock_card_document" model="ir.sequence">
            <field name="name">Engineering Stock Card</field>
            <field name="code">engineering.stock.card.document</field>
            <field name="prefix">SC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>