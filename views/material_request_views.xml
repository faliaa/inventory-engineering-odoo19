<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daftar Material Request -->
    <record id="view_inventory_material_request_list" model="ir.ui.view">
        <field name="name">inventory.material.request.list</field>
        <field name="model">inventory.material.request</field>
        <field name="arch" type="xml">
            <list string="Material Requests"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="approval_user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Formulir Material Request -->
    <record id="view_inventory_material_request_form" model="ir.ui.view">
        <field name="name">inventory.material.request.form</field>
        <field name="model">inventory.material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">

                <header>
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="stock.group_stock_manager"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            groups="stock.group_stock_manager"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['rejected', 'cancelled']"/>

                    <button name="action_cancel"
                            string="Cancel Request"
                            type="object"
                            invisible="state in ['done', 'cancelled']"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved,ready,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Request Information">
                            <field name="request_date"
                                   readonly="state != 'draft'"/>
                            <field name="requester_id"
                                   readonly="state != 'draft'"/>
                            <field name="department"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group string="Stock Locations">
                            <field name="source_location_id"
                                   readonly="state != 'draft'"/>
                            <field name="destination_location_id"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requested Materials"
                              name="requested_materials">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"
                                           readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approval Information"
                              name="approval_information">
                            <group>
                                <field name="approval_user_id"/>
                                <field name="approval_date"/>
                                <field name="rejection_reason"
                                       readonly="state != 'waiting_approval'"
                                       groups="stock.group_stock_manager"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes"
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>

                    <group string="Related Stock Transfer">
                        <field name="picking_id" readonly="1"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Aksi untuk membuka Material Request -->
    <record id="action_inventory_material_request"
            model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">inventory.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>