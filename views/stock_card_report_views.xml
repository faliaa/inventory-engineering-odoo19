<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_engineering_stock_card_report_form" model="ir.ui.view">
        <field name="name">engineering.stock.card.report.form</field>
        <field name="model">engineering.stock.card.report</field>
        <field name="arch" type="xml">
            <form string="Stock Card Excel">
                <group>
                    <field name="product_id"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" invisible="1"/>
                </group>
                <footer>
                    <button name="action_export"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_engineering_stock_card_report" model="ir.actions.act_window">
        <field name="name">Stock Card Excel</field>
        <field name="res_model">engineering.stock.card.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_engineering_stock_card_report_form"/>
        <field name="target">new</field>
    </record>
</odoo>
