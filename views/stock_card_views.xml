<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Daftar Stock Card -->
    <record id="view_engineering_stock_card_list" model="ir.ui.view">
        <field name="name">engineering.stock.card.list</field>
        <field name="model">engineering.stock.card</field>
        <field name="arch" type="xml">
            <list string="Stock Card" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="part_number"/>
                <field name="goods_condition"/>
                <field name="qty_in"/>
                <field name="qty_out"/>
                <field name="product_uom_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Aksi Stock Card -->
    <record id="action_engineering_stock_card" model="ir.actions.act_window">
        <field name="name">Stock Card</field>
        <field name="res_model">engineering.stock.card</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu Stock Card di aplikasi Engineering -->
    <menuitem
        id="menu_engineering_stock_card"
        name="Stock Card"
        parent="menu_inventory_purchase_root"
        action="action_engineering_stock_card"
        sequence="40"
        groups="stock.group_stock_user"
    />

</odoo>