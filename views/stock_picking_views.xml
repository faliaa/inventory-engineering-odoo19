<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_goods_condition" model="ir.ui.view">
        <field name="name">stock.picking.form.goods.condition</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="picking_type_code" invisible="1"/>
                <field name="return_id" invisible="1"/>
                <field name="department_id"
                       invisible="picking_type_code != 'internal'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="goods_condition"
                       string="Kondisi Barang"
                       optional="show"
                       readonly="parent.state in ['done', 'cancel'] or (parent.state != 'draft' and not parent.return_id)"/>
            </xpath>
        </field>
    </record>
</odoo>
