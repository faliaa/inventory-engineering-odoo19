<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_department_list" model="ir.ui.view">
        <field name="name">inventory.department.list</field>
        <field name="model">inventory.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_department_form" model="ir.ui.view">
        <field name="name">inventory.department.form</field>
        <field name="model">inventory.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inventory_departments" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">inventory.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
